<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\RazerMacroUnlocker\Assets\RazerMacroUnlocker.ico</ApplicationIcon>
    <RootNamespace>RazerMacroUnlocker.WinUI</RootNamespace>
    <AssemblyName>RazerMacroUnlocker</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <ProjectReference Include="..\RazerMacroUnlocker.Core\RazerMacroUnlocker.Core.csproj" />
    <Content Include="..\RazerMacroUnlocker\Assets\RazerMacroUnlocker.png" Link="Assets\RazerMacroUnlocker.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\RazerMacroUnlocker\Assets\RazerMacroUnlocker.ico" Link="Assets\RazerMacroUnlocker.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishApplicationResources" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="Build">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>resources.pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>

