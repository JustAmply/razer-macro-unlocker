<Application
    x:Class="RazerMacroUnlocker.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#44D62C</Color>
            <Color x:Key="SystemAccentColorLight1">#63E04F</Color>
            <Color x:Key="SystemAccentColorLight2">#85EA75</Color>
            <Color x:Key="SystemAccentColorLight3">#B5F3AC</Color>
            <Color x:Key="SystemAccentColorDark1">#349F21</Color>
            <Color x:Key="SystemAccentColorDark2">#287D19</Color>
            <Color x:Key="SystemAccentColorDark3">#1C5912</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
